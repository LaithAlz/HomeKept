# Base URL for the HomeKept API. Leave empty (or unset) for same-origin requests.
VITE_API_URL=http://localhost:8080

# PostHog product analytics (frontend/src/lib/analytics.ts). Publishable key —
# safe in the bundle, but still env-config, never hardcoded (arch doc §5.7).
# Leave both unset for local dev/CI: analytics becomes a total no-op.
VITE_PUBLIC_POSTHOG_KEY=
VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
